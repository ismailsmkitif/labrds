[Unit]
Description=E-Commerce CRUD Web App (AWS Cloud Computing)
After=network.target

[Service]
User=ec2-user
WorkingDirectory=/home/ec2-user/ecommerce
Environment="PATH=/home/ec2-user/ecommerce/venv/bin"
ExecStart=/home/ec2-user/ecommerce/venv/bin/gunicorn -w 3 -b 0.0.0.0:80 app:app
Restart=always

[Install]
WantedBy=multi-user.target

